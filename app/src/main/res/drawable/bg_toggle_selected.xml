<?xml version="1.0" encoding="utf-8"?>
<!-- Toggle tab được chọn: viền nâu mảnh + bo góc mềm mại 14dp -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:left="2dp" android:top="2dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/tiu_ink" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item android:right="2dp" android:bottom="2dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/tiu_orange_pastel" />
            <stroke android:width="1.5dp" android:color="@color/tiu_ink" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</layer-list>
