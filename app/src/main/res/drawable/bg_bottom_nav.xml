<?xml version="1.0" encoding="utf-8"?>
<!-- Khối "doodle" thanh điều hướng: viền nâu 1.5dp + bóng lệch bo góc tròn pill 32dp -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:left="3dp" android:top="3dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/tiu_ink" />
            <corners android:radius="32dp" />
        </shape>
    </item>
    <item android:right="3dp" android:bottom="3dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/tiu_card" />
            <stroke android:width="1.5dp" android:color="@color/tiu_ink" />
            <corners android:radius="32dp" />
        </shape>
    </item>
</layer-list>
