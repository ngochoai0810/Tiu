<?xml version="1.0" encoding="utf-8"?>
<!-- Khối "doodle": viền nâu + bóng lệch xuống phải (theo Figma) -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:left="4dp" android:top="4dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/tiu_ink" />
            <corners android:radius="30dp" />
        </shape>
    </item>
    <item android:right="4dp" android:bottom="4dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/tiu_card" />
            <stroke android:width="2dp" android:color="@color/tiu_ink" />
            <corners android:radius="30dp" />
        </shape>
    </item>
</layer-list>
