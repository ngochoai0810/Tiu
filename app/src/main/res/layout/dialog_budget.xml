<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="24dp"
    android:paddingTop="12dp">

    <TextView
        android:id="@+id/fieldCategory"
        style="@style/Widget.Tiu.Input"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:clickable="true"
        android:focusable="true"
        android:hint="@string/choose_category"
        app:drawableEndCompat="@drawable/ic_arrow_drop_down"
        app:drawableTint="@color/tiu_ink" />

    <EditText
        android:id="@+id/inputAmount"
        style="@style/Widget.Tiu.Input"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/budget_hint_amount"
        android:importantForAutofill="no"
        android:inputType="number"
        android:maxLength="17" />

    <TextView
        android:id="@+id/textError"
        style="@style/TextAppearance.Tiu.Caption"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textColor="@color/tiu_expense"
        android:visibility="gone" />
</LinearLayout>
