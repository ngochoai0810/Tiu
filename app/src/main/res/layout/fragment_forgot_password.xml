<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/tiu_paper"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp">

        <LinearLayout
            style="@style/Widget.Tiu.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <ImageView
                android:layout_width="80dp"
                android:layout_height="64dp"
                android:layout_marginBottom="24dp"
                android:importantForAccessibility="no"
                android:scaleType="fitStart"
                android:src="@drawable/tiu_welcome_logo" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ĐẶT LẠI MẬT KHẨU"
                android:textAppearance="@style/TextAppearance.Tiu.Eyebrow" />

            <TextView
                android:id="@+id/textTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Quên mật khẩu?"
                android:textAppearance="@style/TextAppearance.Tiu.H2" />

            <TextView
                android:id="@+id/textSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="24dp"
                android:text="Nhập email đã đăng ký để nhận liên kết đặt lại mật khẩu của bạn."
                android:textAppearance="@style/TextAppearance.Tiu.BodySmall"
                android:textColor="@color/tiu_text_secondary" />

            <!-- Khối nhập email (Trạng thái trước khi gửi) -->
            <LinearLayout
                android:id="@+id/layoutInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    android:text="Email"
                    android:textAppearance="@style/TextAppearance.Tiu.Label" />

                <EditText
                    android:id="@+id/inputEmail"
                    style="@style/Widget.Tiu.Input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:autofillHints="emailAddress"
                    android:hint="ban@email.com"
                    android:inputType="textEmailAddress" />

                <TextView
                    android:id="@+id/textError"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:textColor="@color/tiu_expense"
                    android:textSize="12.5sp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/btnSendReset"
                    style="@style/Widget.Tiu.Button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="Gửi liên kết" />

                <ProgressBar
                    android:id="@+id/progress"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="12dp"
                    android:indeterminateTint="@color/tiu_orange"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- Khối thông báo thành công (Trạng thái 4b) -->
            <LinearLayout
                android:id="@+id/layoutSuccess"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="20dp"
                    android:background="@drawable/bg_doodle_card_warning"
                    android:padding="16dp"
                    android:text="✓ Email đã được gửi! Vui lòng kiểm tra hộp thư đến (và mục spam) để hoàn tất việc đặt lại mật khẩu."
                    android:textAppearance="@style/TextAppearance.Tiu.BodySmall"
                    android:textColor="@color/tiu_ink" />

                <TextView
                    android:id="@+id/btnDone"
                    style="@style/Widget.Tiu.Button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Quay lại Đăng nhập" />
            </LinearLayout>

            <TextView
                android:id="@+id/linkBackToLogin"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="20dp"
                android:padding="8dp"
                android:text="Quay lại Đăng nhập"
                android:textColor="@color/tiu_ink"
                android:textStyle="bold" />

        </LinearLayout>
    </LinearLayout>
</ScrollView>
