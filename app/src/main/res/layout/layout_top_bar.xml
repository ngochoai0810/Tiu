<?xml version="1.0" encoding="utf-8"?>
<!-- Thanh trên cùng theo Figma: nút +, logo "tiu", avatar chữ cái -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="20dp"
    android:paddingTop="12dp"
    android:paddingBottom="8dp">

    <ImageView
        android:id="@+id/btnAdd"
        style="@style/Widget.Tiu.CircleButton"
        android:contentDescription="@string/editor_add_title"
        android:src="@drawable/ic_add"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/logo"
        android:layout_width="wrap_content"
        android:layout_height="44dp"
        android:background="@drawable/bg_doodle_input"
        android:gravity="center"
        android:paddingStart="22dp"
        android:paddingEnd="25dp"
        android:paddingBottom="3dp"
        android:text="@string/app_name"
        android:textColor="@color/tiu_ink"
        android:textSize="17sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@id/btnAdd"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/btnAdd" />

    <TextView
        android:id="@+id/avatar"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="@drawable/bg_avatar"
        android:gravity="center"
        android:paddingEnd="3dp"
        android:paddingBottom="3dp"
        android:textColor="@color/tiu_ink"
        android:textSize="15sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="AN"
        xmlns:tools="http://schemas.android.com/tools" />

</androidx.constraintlayout.widget.ConstraintLayout>
