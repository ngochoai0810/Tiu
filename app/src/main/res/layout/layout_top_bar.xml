<?xml version="1.0" encoding="utf-8"?>
<!-- Thanh trên cùng theo Figma: nút +, logo tiu, chuông thông báo có badge, avatar chữ cái -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="20dp"
    android:paddingTop="12dp"
    android:paddingBottom="8dp">

    <ImageView
        android:id="@+id/btnAdd"
        style="@style/Widget.Tiu.CircleButton"
        android:contentDescription="@string/editor_add_title"
        android:src="@drawable/ic_add"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/logo"
        android:layout_width="55dp"
        android:layout_height="44dp"
        android:importantForAccessibility="no"
        android:scaleType="fitCenter"
        android:src="@drawable/tiu_welcome_logo"
        app:layout_constraintBottom_toBottomOf="@id/btnAdd"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/btnAdd" />

    <FrameLayout
        android:id="@+id/btnNotificationContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="12dp"
        app:layout_constraintEnd_toStartOf="@id/avatar"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/btnNotification"
            style="@style/Widget.Tiu.CircleButton"
            android:contentDescription="Thông báo"
            android:src="@drawable/ic_bell" />

        <TextView
            android:id="@+id/badgeNotification"
            android:layout_width="wrap_content"
            android:layout_height="18dp"
            android:layout_gravity="top|end"
            android:background="@drawable/bg_badge_notification"
            android:gravity="center"
            android:minWidth="18dp"
            android:paddingHorizontal="3dp"
            android:visibility="gone"
            tools:text="3"
            android:textColor="@color/white"
            android:textSize="10sp"
            android:textStyle="bold"
            tools:visibility="visible" />
    </FrameLayout>

    <!-- Đã di chuyển btnSearch sang fragment_home.xml -->

    <TextView
        android:id="@+id/avatar"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="@drawable/bg_avatar"
        android:gravity="center"
        android:paddingEnd="3dp"
        android:paddingBottom="3dp"
        android:textColor="@color/tiu_ink"
        android:textSize="15sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="AN" />

</androidx.constraintlayout.widget.ConstraintLayout>
