<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="#FCF5E6"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:background="@drawable/tiu_welcome_card"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="24dp"
            android:paddingEnd="32dp"
            android:paddingBottom="36dp">

            <ImageView
                android:layout_width="88dp" android:layout_height="70dp"
                android:importantForAccessibility="no"
                android:src="@drawable/tiu_welcome_logo" />

            <TextView
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:letterSpacing="0.10"
                android:text="@string/tiu_welcome_eyebrow"
                android:textColor="#A44823"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:fontFamily="sans-serif"
                android:includeFontPadding="false"
                android:text="@string/tiu_welcome_title"
                android:textColor="#463429"
                android:textSize="28sp" />

            <TextView
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:lineSpacingExtra="4dp"
                android:text="@string/tiu_welcome_description"
                android:textColor="#746457"
                android:textSize="12sp" />

            <FrameLayout
                android:layout_width="match_parent" android:layout_height="146dp"
                android:layout_marginTop="20dp"
                android:background="@drawable/tiu_welcome_photo"
                android:paddingStart="18dp"
                android:paddingTop="18dp"
                android:paddingEnd="22dp"
                android:paddingBottom="24dp">

                <FrameLayout
                    android:layout_width="match_parent" android:layout_height="match_parent"
                    android:background="@drawable/tiu_welcome_photo_outline">

                    <TextView
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_gravity="bottom|start"
                        android:layout_margin="10dp"
                        android:text="@string/tiu_welcome_photo"
                        android:textColor="#463429"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_gravity="top|end"
                        android:background="@drawable/tiu_welcome_badge"
                        android:paddingStart="10dp"
                        android:paddingTop="6dp"
                        android:paddingEnd="10dp"
                        android:paddingBottom="6dp"
                        android:rotation="5"
                        android:text="@string/tiu_welcome_amount"
                        android:textColor="#463429"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </FrameLayout>
            </FrameLayout>

            <TextView
                android:id="@+id/btnStartWithTiu"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/tiu_welcome_button"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:minHeight="54dp"
                android:paddingStart="12dp"
                android:paddingTop="10dp"
                android:paddingEnd="16dp"
                android:paddingBottom="14dp"
                android:text="@string/tiu_welcome_start"
                android:textColor="#2F1C12"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/linkLogin"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:minHeight="48dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="@string/tiu_welcome_login"
                android:textColor="#463429"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
