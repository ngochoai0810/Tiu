<?xml version="1.0" encoding="utf-8"?>
<ScrollView android:layout_width="match_parent" android:layout_height="match_parent"
        xmlns:android="http://schemas.android.com/apk/res/android"
        android:fillViewport="true"
        android:background="#FCF5E6" >
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="12dp" >
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/tiu_welcome_card"
                android:paddingStart="24dp"
                android:paddingEnd="32dp"
                android:paddingTop="24dp"
                android:paddingBottom="16dp" >
            <ImageView android:layout_width="88dp" android:layout_height="70dp"
                    android:src="@drawable/tiu_welcome_logo"
                    android:importantForAccessibility="no"  />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/tiu_notification_step"
                    android:textSize="11sp"
                    android:textColor="#A44823"
                    android:layout_marginTop="22dp"
                    android:letterSpacing="0.10"
                    android:textStyle="bold"  />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/tiu_notification_title"
                    android:textSize="28sp"
                    android:textColor="#483428"
                    android:layout_marginTop="12dp"
                    android:includeFontPadding="false"  />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/tiu_notification_description"
                    android:textSize="13sp"
                    android:textColor="#806A5A"
                    android:layout_marginTop="14dp"
                    android:layout_marginBottom="10dp"
                    android:lineSpacingExtra="3dp"  />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:background="@drawable/tiu_notification_preview"
                    android:paddingStart="12dp"
                    android:paddingEnd="14dp"
                    android:paddingTop="12dp"
                    android:paddingBottom="14dp" >
                <ImageView android:layout_width="36dp" android:layout_height="36dp"
                        android:src="@drawable/tiu_notification_alert_card"
                        android:importantForAccessibility="no"  />
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="10dp"
                        android:layout_marginEnd="4dp" >
                    <TextView
                        android:id="@+id/textReminderTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/tiu_notification_time"
                        android:textColor="#483428"
                        android:textStyle="bold"
                        android:textSize="13sp" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="@string/tiu_notification_sample"
                            android:textSize="11sp"
                            android:textColor="#806A5A"  />
                    <Button
                        android:id="@+id/btnChangeReminderTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:background="?attr/selectableItemBackground"
                        android:gravity="start|center_vertical"
                        android:paddingStart="0dp"
                        android:paddingEnd="12dp"
                        android:text="@string/tiu_notification_change_time"
                        android:textAllCaps="false"
                        android:textColor="#A44823"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>
                <View android:layout_width="8dp" android:layout_height="8dp"
                        android:layout_marginTop="2dp"
                        android:background="@drawable/tiu_notification_dot"
                        android:importantForAccessibility="no"  />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_marginTop="8dp" >
                <ImageView android:layout_width="26dp" android:layout_height="26dp"
                        android:src="@drawable/tiu_notification_alert"
                        android:importantForAccessibility="no"  />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="@string/tiu_notification_alert"
                        android:textSize="13sp"
                        android:textColor="#483428"
                        android:layout_marginStart="10dp"  />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_marginTop="8dp" >
                <ImageView android:layout_width="26dp" android:layout_height="26dp"
                        android:src="@drawable/tiu_notification_weekly"
                        android:importantForAccessibility="no"  />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="@string/tiu_notification_weekly"
                        android:textSize="13sp"
                        android:textColor="#483428"
                        android:layout_marginStart="10dp"  />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_marginTop="8dp" >
                <ImageView android:layout_width="26dp" android:layout_height="26dp"
                        android:src="@drawable/tiu_notification_friends"
                        android:importantForAccessibility="no"  />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="@string/tiu_notification_friends"
                        android:textSize="13sp"
                        android:textColor="#483428"
                        android:layout_marginStart="10dp"  />
            </LinearLayout>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:id="@+id/btnEnableNotification"
                    android:layout_marginTop="14dp"
                    android:minHeight="50dp"
                    android:gravity="center"
                    android:paddingBottom="5dp"
                    android:background="@drawable/tiu_welcome_button"
                    android:text="@string/tiu_notification_enable"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:clickable="true"
                    android:focusable="true"  />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/tiu_notification_skip"
                    android:textSize="13sp"
                    android:textColor="#806A5A"
                    android:id="@+id/linkSkip"
                    android:layout_gravity="center_horizontal"
                    android:gravity="center"
                    android:minHeight="44dp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:textStyle="bold"
                    android:clickable="true"
                    android:focusable="true"  />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
