<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/tiu_paper"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:padding="24dp">

        <LinearLayout
            style="@style/Widget.Tiu.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/register_eyebrow"
                android:textAppearance="@style/TextAppearance.Tiu.Eyebrow" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:text="@string/register_title"
                android:textAppearance="@style/TextAppearance.Tiu.H2" />

            <EditText
                android:id="@+id/inputName"
                style="@style/Widget.Tiu.Input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:autofillHints="name"
                android:hint="@string/hint_name"
                android:inputType="textPersonName|textCapWords" />

            <EditText
                android:id="@+id/inputEmail"
                style="@style/Widget.Tiu.Input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:autofillHints="emailAddress"
                android:hint="@string/hint_email"
                android:inputType="textEmailAddress" />

            <EditText
                android:id="@+id/inputPassword"
                style="@style/Widget.Tiu.Input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:autofillHints="newPassword"
                android:hint="@string/hint_password"
                android:inputType="textPassword" />

            <EditText
                android:id="@+id/inputConfirm"
                style="@style/Widget.Tiu.Input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:autofillHints="newPassword"
                android:hint="@string/hint_password_confirm"
                android:inputType="textPassword" />

            <TextView
                android:id="@+id/textError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:textColor="@color/tiu_expense"
                android:textSize="12.5sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/btnRegister"
                style="@style/Widget.Tiu.Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="@string/action_register" />

            <ProgressBar
                android:id="@+id/progress"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="12dp"
                android:indeterminateTint="@color/tiu_orange"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:id="@+id/linkLogin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="20dp"
            android:padding="8dp"
            android:text="@string/to_login"
            android:textColor="@color/tiu_orange"
            android:textStyle="bold" />
    </LinearLayout>
</ScrollView>
