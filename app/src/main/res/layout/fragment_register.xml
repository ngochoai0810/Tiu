<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/tiu_paper"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp">

        <LinearLayout
            style="@style/Widget.Tiu.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <ImageView
                android:layout_width="80dp"
                android:layout_height="64dp"
                android:layout_marginBottom="24dp"
                android:importantForAccessibility="no"
                android:scaleType="fitStart"
                android:src="@drawable/tiu_welcome_logo" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TẠO TÀI KHOẢN"
                android:textAppearance="@style/TextAppearance.Tiu.Eyebrow" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Bắt đầu nhật ký mới"
                android:textAppearance="@style/TextAppearance.Tiu.H2" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="24dp"
                android:text="Dữ liệu của bạn được lưu riêng tư và đồng bộ an toàn."
                android:textAppearance="@style/TextAppearance.Tiu.BodySmall"
                android:textColor="@color/tiu_text_secondary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:text="Họ và tên"
                android:textAppearance="@style/TextAppearance.Tiu.Label" />

            <EditText
                android:id="@+id/inputName"
                style="@style/Widget.Tiu.Input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:autofillHints="name"
                android:hint="An Nguyễn"
                android:inputType="textPersonName|textCapWords" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="6dp"
                android:text="Email"
                android:textAppearance="@style/TextAppearance.Tiu.Label" />

            <EditText
                android:id="@+id/inputEmail"
                style="@style/Widget.Tiu.Input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:autofillHints="emailAddress"
                android:hint="ban@email.com"
                android:inputType="textEmailAddress" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="6dp"
                android:text="Mật khẩu"
                android:textAppearance="@style/TextAppearance.Tiu.Label" />

            <EditText
                android:id="@+id/inputPassword"
                style="@style/Widget.Tiu.Input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:autofillHints="newPassword"
                android:hint="Từ 6 đến 8 ký tự"
                android:inputType="textPassword" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="6dp"
                android:text="@string/hint_password_confirm"
                android:textAppearance="@style/TextAppearance.Tiu.Label" />
            <EditText
                android:id="@+id/inputConfirm"
                style="@style/Widget.Tiu.Input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:autofillHints="newPassword"
                android:hint="@string/hint_password_confirm"
                android:inputType="textPassword" />

            <TextView
                android:id="@+id/textError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:textColor="@color/tiu_expense"
                android:textSize="12.5sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/btnRegister"
                style="@style/Widget.Tiu.Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Đăng ký" />

            <ProgressBar
                android:id="@+id/progress"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="12dp"
                android:indeterminateTint="@color/tiu_orange"
                android:visibility="gone" />

            <TextView
                android:id="@+id/linkLogin"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="20dp"
                android:padding="8dp"
                android:text="Đã có tài khoản? Đăng nhập"
                android:textColor="@color/tiu_ink"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
