<?xml version="1.0" encoding="utf-8"?>
<!-- startDestination được MainActivity đặt lại: đã đăng nhập -> homeFragment, chưa -> loginFragment -->
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/loginFragment">

    <fragment
        android:id="@+id/loginFragment"
        android:name="vn.edu.dut.tiu.ui.auth.LoginFragment"
        android:label="Đăng nhập" />

    <fragment
        android:id="@+id/registerFragment"
        android:name="vn.edu.dut.tiu.ui.auth.RegisterFragment"
        android:label="Đăng ký" />

    <fragment
        android:id="@+id/forgotPasswordFragment"
        android:name="vn.edu.dut.tiu.ui.auth.ForgotPasswordFragment"
        android:label="Quên mật khẩu" />

    <fragment
        android:id="@+id/homeFragment"
        android:name="vn.edu.dut.tiu.ui.home.HomeFragment"
        android:label="@string/nav_home" />

    <fragment
        android:id="@+id/searchFragment"
        android:name="vn.edu.dut.tiu.ui.home.SearchFragment" />

    <fragment
        android:id="@+id/transactionEditorFragment"
        android:name="vn.edu.dut.tiu.ui.transaction.TransactionEditorFragment"
        android:label="Giao dịch">
        <argument
            android:name="transactionId"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true" />
    </fragment>

    <fragment
        android:id="@+id/statsFragment"
        android:name="vn.edu.dut.tiu.ui.stats.StatsFragment"
        android:label="@string/nav_stats" />

    <fragment
        android:id="@+id/cameraFragment"
        android:name="vn.edu.dut.tiu.ui.camera.CameraFragment"
        android:label="@string/nav_camera" />

    <fragment
        android:id="@+id/budgetFragment"
        android:name="vn.edu.dut.tiu.ui.budget.BudgetFragment"
        android:label="@string/nav_budget" />

    <fragment
        android:id="@+id/accountFragment"
        android:name="vn.edu.dut.tiu.ui.account.AccountFragment"
        android:label="@string/nav_account" />

    <fragment
        android:id="@+id/categoryFragment"
        android:name="vn.edu.dut.tiu.ui.category.CategoryFragment"
        android:label="Danh mục" />

    <fragment
        android:id="@+id/notificationFragment"
        android:name="vn.edu.dut.tiu.ui.notification.NotificationFragment"
        android:label="Thông báo" />

    <fragment
        android:id="@+id/notificationSettingsFragment"
        android:name="vn.edu.dut.tiu.ui.notification.NotificationSettingsFragment"
        android:label="Cài đặt thông báo" />

</navigation>
