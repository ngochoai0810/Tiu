<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.Tiu" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/tiu_orange</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/tiu_orange_pastel</item>
        <item name="colorOnPrimaryContainer">@color/tiu_ink</item>
        <item name="colorSecondary">@color/tiu_orange_pastel</item>
        <item name="colorOnSecondary">@color/tiu_ink</item>
        <item name="colorSecondaryContainer">@color/tiu_orange_pastel</item>
        <item name="colorOnSecondaryContainer">@color/tiu_ink</item>
        <item name="colorSurface">@color/tiu_card</item>
        <item name="colorOnSurface">@color/tiu_ink</item>
        <item name="colorOnSurfaceVariant">@color/tiu_text_secondary</item>
        <item name="colorSurfaceContainerHigh">@color/tiu_card</item>
        <item name="colorOutline">@color/tiu_ink</item>
        <item name="colorError">@color/tiu_expense</item>
        <item name="android:colorBackground">@color/tiu_paper</item>
        <item name="android:textColorPrimary">@color/tiu_ink</item>
        <item name="android:textColorSecondary">@color/tiu_text_secondary</item>
        <item name="android:statusBarColor">@color/tiu_paper</item>
        <item name="android:navigationBarColor">@color/tiu_paper</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">true</item>
    </style>

    <!-- ===== Typography (Figma: 06 Typography) ===== -->
    <style name="TextAppearance.Tiu.Display" parent="TextAppearance.Material3.DisplaySmall">
        <item name="android:textSize">34sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/tiu_ink</item>
    </style>
    <style name="TextAppearance.Tiu.H1" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:textSize">28sp</item>
        <item name="android:textColor">@color/tiu_ink</item>
    </style>
    <style name="TextAppearance.Tiu.H2" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:textSize">24sp</item>
        <item name="android:textColor">@color/tiu_ink</item>
    </style>
    <style name="TextAppearance.Tiu.H3" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textSize">19sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/tiu_ink</item>
    </style>
    <style name="TextAppearance.Tiu.Eyebrow" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textSize">10sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.12</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textColor">@color/tiu_orange</item>
    </style>
    <style name="TextAppearance.Tiu.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textSize">13.5sp</item>
        <item name="android:textColor">@color/tiu_ink</item>
    </style>
    <style name="TextAppearance.Tiu.BodySmall" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textSize">12.5sp</item>
        <item name="android:textColor">@color/tiu_ink</item>
    </style>
    <style name="TextAppearance.Tiu.Caption" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textSize">11sp</item>
        <item name="android:textColor">@color/tiu_text_secondary</item>
    </style>
    <style name="TextAppearance.Tiu.Label" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textSize">12.5sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/tiu_ink</item>
    </style>

    <!-- ===== Widget "doodle" ===== -->
    <style name="Widget.Tiu.Input" parent="">
        <item name="android:background">@drawable/bg_doodle_input</item>
        <item name="android:minHeight">54dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">15dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/tiu_ink</item>
        <item name="android:textColorHint">@color/tiu_text_secondary</item>
        <item name="android:gravity">center_vertical</item>
    </style>

    <style name="Widget.Tiu.Button" parent="">
        <item name="android:background">@drawable/bg_doodle_button</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingBottom">4dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:foreground">?attr/selectableItemBackground</item>
    </style>

    <style name="Widget.Tiu.Button.Ghost">
        <item name="android:background">@drawable/bg_doodle_card</item>
        <item name="android:textColor">@color/tiu_ink</item>
    </style>

    <style name="Widget.Tiu.Button.Dashed">
        <item name="android:background">@drawable/bg_dashed</item>
        <item name="android:paddingBottom">0dp</item>
        <item name="android:textColor">@color/tiu_orange</item>
    </style>

    <style name="Widget.Tiu.Card" parent="">
        <item name="android:background">@drawable/bg_doodle_card</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">18dp</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">18dp</item>
    </style>

    <style name="Widget.Tiu.CircleButton" parent="">
        <item name="android:layout_width">48dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:background">@drawable/bg_doodle_circle</item>
        <item name="android:padding">12dp</item>
        <item name="android:paddingBottom">15dp</item>
        <item name="android:paddingEnd">15dp</item>
        <item name="tint">@color/tiu_ink</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="Widget.Tiu.BottomNav" parent="Widget.Material3.BottomNavigationView">
        <item name="android:background">@drawable/bg_bottom_nav</item>
        <item name="backgroundTint">@null</item>
        <item name="elevation">0dp</item>
        <item name="labelVisibilityMode">unlabeled</item>
        <item name="itemIconTint">@color/bottom_nav_icon</item>
        <item name="itemActiveIndicatorStyle">@style/Widget.Tiu.BottomNav.Indicator</item>
    </style>

    <style name="Widget.Tiu.BottomNav.Indicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/tiu_orange_pastel</item>
    </style>
</resources>
